# Brave Search subscription token. Sent only as X-Subscription-Token.
# PRIZE_SCOUT_SEARCH_API_KEY=

# Free searches one browser may run per day in the cap time zone. Default 10.
# PRIZE_SCOUT_FREE_DAILY_CAP=10

# Older name for the same per-browser cap. Used when FREE_DAILY_CAP is unset.
# PRIZE_SCOUT_SEARCH_DAILY_CAP=10

# Shared budget across every browser. Unset means no extra global stop.
# PRIZE_SCOUT_GLOBAL_DAILY_CAP=

# Day boundary for the free cap. Default America/Boise.
# PRIZE_SCOUT_CAP_TIMEZONE=America/Boise

# Shown when the free cap is used up. Empty hides the link.
# PRIZE_SCOUT_DONATION_URL=

# Ko-fi webhook verification token. Compared in constant time. Never logged.
# PRIZE_SCOUT_KOFI_VERIFICATION_TOKEN=

# Dollars of search cost one upstream search records. Default 0.025.
# PRIZE_SCOUT_COST_PER_SEARCH_USD=0.025

# Share of a matched donation's searches credited to that browser. Default 0.5. The rest joins the pool.
# PRIZE_SCOUT_DONOR_SHARE=0.5

# Extra community-pool searches one browser may use per day after the free cap. Default 10.
# PRIZE_SCOUT_POOL_DAILY_CAP=10

# When month spend reaches this, the pool pauses. Free cap and donor bonus continue. Unset means no ceiling.
# PRIZE_SCOUT_MONTHLY_CEILING_USD=

# Days until a donor bonus expires. Unset means the bonus does not expire.
# PRIZE_SCOUT_BONUS_EXPIRY_DAYS=

# Signs the browser id cookie. Required on Workers. The Mac app has a local fallback.
# PRIZE_SCOUT_COOKIE_SECRET=

# Comma-separated browser ids that may open owner routes on a public host.
# PRIZE_SCOUT_OWNER_BROWSER_IDS=

# Private /owner page. The page is 404 without this exact token.
# PRIZE_SCOUT_OWNER_TOKEN=

# Starting prepaid credit in dollars. Editable later on /owner.
# PRIZE_SCOUT_BRAVE_CREDIT_USD=

# Dollars charged per Brave request. Default 0.005.
# PRIZE_SCOUT_BRAVE_COST_USD=0.005

# Banner and optional webhook when estimated credit is under this amount. Default 2.
# PRIZE_SCOUT_LOW_CREDIT_USD=2

# Optional POST target for the low-credit notice. Unset means nothing is sent.
# PRIZE_SCOUT_ALERT_WEBHOOK_URL=

# Home footer link. Hidden when unset.
# PRIZE_SCOUT_TIP_URL=
