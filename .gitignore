# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
.next-vitest/
/.next-vitest/
/out/
.open-next/
.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local app data, if a later build writes any
/data
/data/**
.dev.vars
owner-link.txt
*.zip
.open-next/
.wrangler/
/tests/fixtures/stress/
/tests/fixtures/retest/*.html
/tests/fixtures/retest/**/*.html
/tests/fixtures/retest/*.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.vitest.json
